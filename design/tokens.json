{
  "$schema": "https://design-tokens.org/schema/dtcg-draft.json",
  "color": {
    "primitive": {
      "slate-50":  { "$type": "color", "$value": "#f8fafc" },
      "slate-100": { "$type": "color", "$value": "#f1f5f9" },
      "slate-200": { "$type": "color", "$value": "#e2e8f0" },
      "slate-300": { "$type": "color", "$value": "#cbd5e1" },
      "slate-400": { "$type": "color", "$value": "#94a3b8" },
      "slate-500": { "$type": "color", "$value": "#64748b" },
      "slate-600": { "$type": "color", "$value": "#475569" },
      "slate-700": { "$type": "color", "$value": "#334155" },
      "slate-800": { "$type": "color", "$value": "#1e293b" },
      "slate-900": { "$type": "color", "$value": "#0f172a" },
      "indigo-50":  { "$type": "color", "$value": "#eef2ff" },
      "indigo-100": { "$type": "color", "$value": "#e0e7ff" },
      "indigo-500": { "$type": "color", "$value": "#6366f1" },
      "indigo-600": { "$type": "color", "$value": "#4f46e5" },
      "indigo-700": { "$type": "color", "$value": "#4338ca" },
      "emerald-50": { "$type": "color", "$value": "#ecfdf5" },
      "emerald-600": { "$type": "color", "$value": "#059669" },
      "amber-50":   { "$type": "color", "$value": "#fffbeb" },
      "amber-600":  { "$type": "color", "$value": "#d97706" },
      "red-50":     { "$type": "color", "$value": "#fef2f2" },
      "red-600":    { "$type": "color", "$value": "#dc2626" },
      "white":      { "$type": "color", "$value": "#ffffff" }
    },
    "semantic": {
      "surface-page":     { "$type": "color", "$value": "{color.primitive.slate-50}" },
      "surface-card":     { "$type": "color", "$value": "{color.primitive.white}" },
      "surface-muted":    { "$type": "color", "$value": "{color.primitive.slate-100}" },
      "border-default":   { "$type": "color", "$value": "{color.primitive.slate-200}" },
      "border-strong":    { "$type": "color", "$value": "{color.primitive.slate-300}" },
      "text-primary":     { "$type": "color", "$value": "{color.primitive.slate-900}" },
      "text-secondary":   { "$type": "color", "$value": "{color.primitive.slate-600}" },
      "text-muted":       { "$type": "color", "$value": "{color.primitive.slate-500}" },
      "action-primary":      { "$type": "color", "$value": "{color.primitive.indigo-600}", "$comment": "overridden by tenant accent at runtime" },
      "action-primary-hover":{ "$type": "color", "$value": "{color.primitive.indigo-700}" },
      "action-primary-fg":   { "$type": "color", "$value": "{color.primitive.white}" },
      "status-success":   { "$type": "color", "$value": "{color.primitive.emerald-600}" },
      "status-warning":   { "$type": "color", "$value": "{color.primitive.amber-600}" },
      "status-danger":    { "$type": "color", "$value": "{color.primitive.red-600}" },
      "status-success-bg":{ "$type": "color", "$value": "{color.primitive.emerald-50}" },
      "status-warning-bg":{ "$type": "color", "$value": "{color.primitive.amber-50}" },
      "status-danger-bg": { "$type": "color", "$value": "{color.primitive.red-50}" },
      "focus-ring":       { "$type": "color", "$value": "{color.primitive.indigo-500}" }
    },
    "status": {
      "trial":    { "$type": "color", "$value": "{color.primitive.indigo-600}" },
      "active":   { "$type": "color", "$value": "{color.primitive.emerald-600}" },
      "grace":    { "$type": "color", "$value": "{color.primitive.amber-600}" },
      "suspended":{ "$type": "color", "$value": "{color.primitive.red-600}" },
      "pending":  { "$type": "color", "$value": "{color.primitive.slate-500}" }
    }
  },
  "font": {
    "family": {
      "sans": { "$type": "fontFamily", "$value": "Inter, ui-sans-serif, system-ui, sans-serif" },
      "mono": { "$type": "fontFamily", "$value": "ui-monospace, SFMono-Regular, monospace" }
    },
    "size": {
      "xs":  { "$type": "dimension", "$value": "0.75rem" },
      "sm":  { "$type": "dimension", "$value": "0.875rem" },
      "md":  { "$type": "dimension", "$value": "1rem" },
      "lg":  { "$type": "dimension", "$value": "1.125rem" },
      "xl":  { "$type": "dimension", "$value": "1.25rem" },
      "2xl": { "$type": "dimension", "$value": "1.5rem" },
      "3xl": { "$type": "dimension", "$value": "1.875rem" },
      "4xl": { "$type": "dimension", "$value": "2.25rem" }
    },
    "weight": {
      "regular": { "$type": "fontWeight", "$value": "400" },
      "medium":  { "$type": "fontWeight", "$value": "500" },
      "semibold":{ "$type": "fontWeight", "$value": "600" },
      "bold":    { "$type": "fontWeight", "$value": "700" }
    },
    "lineHeight": {
      "tight":  { "$type": "number", "$value": 1.25 },
      "normal": { "$type": "number", "$value": 1.5 }
    }
  },
  "spacing": {
    "1": { "$type": "dimension", "$value": "0.25rem" },
    "2": { "$type": "dimension", "$value": "0.5rem" },
    "3": { "$type": "dimension", "$value": "0.75rem" },
    "4": { "$type": "dimension", "$value": "1rem" },
    "5": { "$type": "dimension", "$value": "1.25rem" },
    "6": { "$type": "dimension", "$value": "1.5rem" },
    "8": { "$type": "dimension", "$value": "2rem" },
    "10":{ "$type": "dimension", "$value": "2.5rem" },
    "12":{ "$type": "dimension", "$value": "3rem" },
    "16":{ "$type": "dimension", "$value": "4rem" }
  },
  "radius": {
    "sm":   { "$type": "dimension", "$value": "0.25rem" },
    "md":   { "$type": "dimension", "$value": "0.5rem" },
    "lg":   { "$type": "dimension", "$value": "0.75rem" },
    "xl":   { "$type": "dimension", "$value": "1rem" },
    "full": { "$type": "dimension", "$value": "9999px" }
  },
  "shadow": {
    "sm": { "$type": "shadow", "$value": "0 1px 2px 0 rgb(15 23 42 / 0.05)" },
    "md": { "$type": "shadow", "$value": "0 4px 6px -1px rgb(15 23 42 / 0.1), 0 2px 4px -2px rgb(15 23 42 / 0.1)" },
    "lg": { "$type": "shadow", "$value": "0 10px 15px -3px rgb(15 23 42 / 0.1), 0 4px 6px -4px rgb(15 23 42 / 0.1)" }
  },
  "breakpoint": {
    "mobile":  { "$type": "dimension", "$value": "375px" },
    "tablet":  { "$type": "dimension", "$value": "768px" },
    "desktop": { "$type": "dimension", "$value": "1280px" }
  },
  "tenant": {
    "logo-url":      { "$type": "other", "$value": "var(--tenant-logo-url)" },
    "primary":       { "$type": "other", "$value": "var(--tenant-primary)" },
    "primary-hover": { "$type": "other", "$value": "var(--tenant-primary-hover)" },
    "favicon":       { "$type": "other", "$value": "var(--tenant-favicon)" }
  }
}
