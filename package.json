{
    "name": "elanjai-buildos",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "workspaces": [
        "apps/*",
        "packages/*"
    ],
    "scripts": {
        "dev": "npm run dev -w @buildos/tenant",
        "dev:landing": "npm run dev -w @buildos/landing",
        "dev:tenant": "npm run dev -w @buildos/tenant",
        "dev:admin": "npm run dev -w @buildos/admin",
        "build": "npm run build --workspaces --if-present",
        "build:landing": "npm run build -w @buildos/landing",
        "build:tenant": "npm run build -w @buildos/tenant",
        "build:admin": "npm run build -w @buildos/admin",
        "typecheck": "npm run typecheck --workspaces --if-present",
        "lint": "eslint .",
        "preview": "npm run preview -w @buildos/tenant"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.2",
        "eslint": "^9.28.0",
        "eslint-plugin-react-hooks": "^5.2.0",
        "eslint-plugin-react-refresh": "^0.4.19",
        "globals": "^16.0.0",
        "typescript-eslint": "^8.38.0"
    }
}
